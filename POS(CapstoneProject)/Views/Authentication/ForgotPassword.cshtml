@model POS_CapstoneProject_.Models.User

@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<!--Loader-->
<div class="loader-wrapper-login">
    <div class="loader-login"></div>
</div>

<div class="forgot-password-wrapper">
   <h1>RESET PASSWORD</h1>
   <p>Enter the email associated with your account and we'll send you the code.</p>

    <form method="post" asp-action="ForgotPassword" id="sendCodeForm">
        <div class="form-group">
            <label class="control-label">Email:</label>
            <input type="email" name="email" class="form-control" required />
        </div>
     
        <div class="form-group">
            <button type="button" class="sendCodeBtn" onclick="sendCode()">SEND CODE</button>
        </div>
            
        <a href="@Url.Action("Login", "Authentication")">Back to Login</a>           
   </form>
</div> 


@if (ViewData["NotExist"] != null)
{
    <script>
        Swal.fire({
            text: "Email not found",
            icon: "error",
            showConfirmButton: false,
            timer: 2000
        });
    </script>
}

@if (ViewData["Error"] != null)
{
    <script>
        Swal.fire({
            text: "@ViewData["Error"]",
            icon: "error",
            showConfirmButton: false,
            timer: 2000
        });
    </script>
}


@if (ViewData["Success"] != null)
{
    <script>
        Swal.fire({
            text: "Code has beeen sent to your Email",
            icon: "info",
            showConfirmButton: false,
            timer: 2000
        }).then(() => {
            setTimeout(() => {
                window.location.href = '@Url.Action("CodeVerification", "Authentication")';
            }, 500)
         
        });
    </script>
}





