@model POS_CapstoneProject_.Models.User

@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<!--Loader-->
<div class="loader-wrapper-login">
    <div class="loader-login"></div>
</div>

<div class="code-verification-wrapper">
    <h1>CHECK YOUR EMAIL</h1>
    <p>We have sent the code in your email. Please enter your 6-digit code. </p>



    <form method="post" asp-action="CodeVerification" class="confirmCodeForm">

        <input name="code" class="inputConfirmationCode" hidden />
        <div class="form-group code-wrapper">
            <input maxlength="1" required />
            <input maxlength="1" required />
            <input maxlength="1" required />
            <input maxlength="1" required />
            <input maxlength="1" required />
            <input maxlength="1" required />
        </div>


        <div class="form-group">
            <button type="button" onclick="confirmCode()" class="nextBtn">NEXT</button>
        </div>

       
         <a href="@Url.Action("Login", "Authentication")">Back to Login</a>
       

    </form>
</div>

@if (ViewData["IncorrectCode"] != null)
{
    <script>
        Swal.fire({
            text: "Incorrect Verification Code",
            icon: "error",
            showConfirmButton: false,
            timer: 2000
        })
    </script>
}


@if (ViewData["Error"] != null)
{
    <script>
        Swal.fire({
            text: "@ViewData["Error"]",
            icon: "error",
            showConfirmButton: false,
            timer: 2000,
        });
    </script>
}