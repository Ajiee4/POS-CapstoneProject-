@model POS_CapstoneProject_.Models.User

@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}


<!--Loader-->
<div class="loader-wrapper-login">
    <div class="loader-login"></div>
</div>
<div class="create-password-wrapper">
    <h1 class="new-header">NEW PASSWORD</h1>
    <p class="new-info"> Create  new password and confirm your new password. </p>



    <form method="post" asp-action="CreatePassword" class="savePasswordForm">

        <div class="form-group">
            <label class="control-label">New Password</label>
            <input type="password" maxlength="30" name="password" class="form-control newPassword" required />

        </div>

        <div class="form-group">
            <label class="control-label">Confirm New Password</label>
            <input name="password" maxlength="30" type="password" class="form-control confirmPassword" required />
        </div>

        <div class="form-group">
            <button type="button" onclick="saveNewPassword()" class="savePasswordBtn">SAVE PASSWORD</button>
        </div>

        <span class="back-to-login" onclick="backToLogin(this)">
            <a href="@Url.Action("Login", "Authentication")">Back to Login</a>
        </span>

    </form>
</div>

@if (ViewData["PasswordChanged"] != null)
{
    <script>
        Swal.fire({
            text: "You successfully change your password",
            icon: "success",
            showConfirmButton: false,
            timer: 2000
        }).then(() => {
            setTimeout(() => {
                window.location.href = '@Url.Action("Login", "Authentication")';
            }, 500)

        });
    </script>
}


@if (ViewData["Error"] != null)
{
    <script>
        Swal.fire({
            text: "@ViewData["Error"]",
            icon: "error",
            showConfirmButton: false,
            timer: 2000,
        });
    </script>
}