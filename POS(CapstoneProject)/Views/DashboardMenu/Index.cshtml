<script>
    const chartOptions = {
        chart: {
            type: 'area',
            height: 500,
            animations: {
                enabled: true,
                easing: 'easeinout',
                speed: 800,
                animateGradually: {
                    enabled: true,
                    delay: 150
                },
                dynamicAnimation: {
                    enabled: true,
                    speed: 350
                }
            },
            toolbar: {
                show: false
            },
            background: 'transparent'
        },
        colors: [
            '#342825',  // Original Color
            '#2b1e1b',  // Darker Shade 1
            '#251b1b',  // Darker Shade 2
            '#4a3a38',  // Lighter Shade 1
            '#5f4e4c'   // Lighter Shade 2
        ],
        fill: {
            type: 'gradient',
            gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.7,
                opacityTo: 0.9,
                stops: [20, 90, 100]
            }
        },
        dataLabels: {
            enabled: false
        },
        stroke: {
            curve: 'smooth',
            width: 3
        },
        xaxis: {
            categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            labels: {
                style: {
                    colors: '#000'
                }
            }
        },
        yaxis: {
            labels: {
                style: {
                    colors: '#000'
                }
            }
        },
        tooltip: {
            theme: 'dark'
        },
        grid: {
            borderColor: 'rgba(0, 0, 0, .4)'
        }
    };

    const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(salesData));

    console.log(salesData);

    // Extract months and amounts for the chart
    const chartMonths = salesData.map(data => data.Month);
    const chartAmounts = salesData.map(data => data.Amount);

    const salesChart = new ApexCharts(document.querySelector("#salesChart"), {
        ...chartOptions,
        series: [{
            name: 'Sales',
            data: chartAmounts
        }],
        xaxis: {
            categories: chartMonths // Set the x-axis to display the months
        }
    });
    salesChart.render();
</script>