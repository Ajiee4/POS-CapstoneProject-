@using Newtonsoft.Json;
@using System.Text.Json
@using Newtonsoft.Json.Linq;
@using POS_CapstoneProject_.DTO;

@{
    Layout = "/Views/Shared/_ManagerLayout.cshtml";
    var salesReportJson = ViewData["SalesData"] as string;
    var salesData = string.IsNullOrEmpty(salesReportJson) ? null : JsonConvert.DeserializeObject<List<SalesData>>(salesReportJson);

  
    var monthlyRanking = ViewData["monthlyRanking"] as string;
    var yearlyRanking = ViewData["yearlyRanking"] as string;

    var dailyRanking = ViewData["dailyRanking"] as string;
    var dailyRankingList = string.IsNullOrEmpty(dailyRanking) ? null : JsonConvert.DeserializeObject<List<SalesReport>>(dailyRanking);
    var monthlyRankingList = string.IsNullOrEmpty(monthlyRanking) ? null : JsonConvert.DeserializeObject<List<SalesReport>>(monthlyRanking);
    var yearlyRankingList = string.IsNullOrEmpty(yearlyRanking) ? null : JsonConvert.DeserializeObject<List<SalesReport>>(yearlyRanking);
}

<style>
    .link-dashboard {
        background-color: #747474 !important;
    }
</style>



<div class="dashboard-wrapper">
    <div class="topbox">
        <div class="box first">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        <div>@ViewData["UCount"]</div>
                    </div>
                    <div class="noUser">
                        <div>
                            No. of Users
                        </div>
                    </div>
                </div>
                <div class="box-top-right">

                    <img src="~/images/totalUsers.png" />

                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">

                    <a href="@Url.Action("Index", "UserManagementMenu")">
                        <span class="view-more">view more</span>
                        <img src="~/images/next-black.png" />
                    </a>
                 
                </div>

            </div>

        </div>
        <div class="box first">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        <div>@ViewData["DailySales"]</div>
                    </div>
                    <div class="noUser">
                        <div>
                            Daily Sales
                        </div>
                    </div>
                </div>
                <div class="box-top-right">

                    <img src="~/images/totalSales.png" />

                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">
                     
                    <a href="@Url.Action("Index", "SalesReportMenu")">
                        <span class="view-more">view more</span>
                        <img src="~/images/next-black.png" />
                    </a>
                   
                </div>

            </div>

        </div>
        <div class="box first">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        <div>@ViewData["PCount"]</div>
                    </div>
                    <div class="noUser">
                        <div>
                            No. of Products
                        </div>
                    </div>
                </div>
                <div class="box-top-right">

                    <img src="~/images/products_b.png" />

                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">

                    <a href="@Url.Action("Index", "ProductMenu")">
                        <span class="view-more">view more</span>
                        <img src="~/images/next-black.png" />
                    </a>
                   
                </div>

            </div>

        </div>
        <div class="box first">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        <div>@ViewData["pendingCount"]</div>
                    </div>
                    <div class="noUser">
                        <div>
                            Pending Requests
                        </div>
                    </div>
                </div>
                <div class="box-top-right">

                    <img src="~/images/totalUsers.png" />

                </div>
            </div>

            <div class="box-bottom">
                <div asp-action="" class="box-bottom-view">
                    <a href="@Url.Action("RequestList", "InventoryMenu")">
                        <span class="view-more">view more</span>
                        <img src="~/images/next-black.png" />
                    </a>                
                </div>

            </div>

        </div>
    </div>
    <div class="middlebox">
        <div class="charts-container">
            <div class="chart-card glow">
                <h3>Sales Analytics</h3>
                <div id="salesChart"></div>
            </div>
        </div>
        <div id="leaderboard">
         
            <h3 class="card-title"> Product Ranking</h3>
            <div class="sortbutton">
                <button class="btn btn-outline-dark active" onclick="filterProdRanking('Daily', this)">Daily </button>
                <button class="btn btn-outline-dark" onclick="filterProdRanking('Monthly', this)">Monthly </button>
                <button class="btn btn-outline-dark" onclick="filterProdRanking('Yearly', this)">Yearly </button>
            </div>
            <div class="ranking">              
               <div class="daily-ranking">
                    @if (ViewData["dailyRanking"] != null)
                    {
                        int rank = 1;
                        foreach(var item in dailyRankingList)
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h1 class="rank">@rank</h1>
                                    @if(item.ImageBase64 == null)
                                    {
                                        <div class="noImage"></div>
                                    }
                                    else
                                    {
                                        <div class="withImage">
                                            <img src="data:image/jpeg;base64,@item.ImageBase64" alt="Image">
                                        </div>
                                       
                                    }
                                   
                                    <div class="name">@item.Name</div>                                 
                                </div>
                                <div class="card-body">
                                    <h3 class="sold">@item.TotalSold</h3>                                 
                                </div>                                
                            </div>
                            rank++;
                        }
                    }
               </div>

                <div class="monthly-ranking">
                    @if (ViewData["monthlyRanking"] != null)
                    {
                        int rank = 1;
                        foreach (var item in monthlyRankingList)
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h1 class="rank">@rank</h1>
                                    @if (item.ImageBase64 == null)
                                    {
                                        <div class="noImage"></div>
                                    }
                                    else
                                    {
                                        <div class="withImage">
                                            <img src="data:image/jpeg;base64,@item.ImageBase64" alt="Image">
                                        </div>
                                    }
                                    <div class="name">@item.Name</div>
                                </div>
                                <div class="card-body">
                                    <h3 class="sold">@item.TotalSold</h3>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                </div>

                <div class="yearly-ranking">
                    @if (ViewData["yearlyRanking"] != null)
                    {
                        int rank = 1;
                        foreach (var item in yearlyRankingList)
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h1 class="rank">@rank</h1>
                                    @if (item.ImageBase64 == null)
                                    {
                                        <div class="noImage"></div>
                                    }
                                    else
                                    {
                                        <div class="withImage">
                                            <img src="data:image/jpeg;base64,@item.ImageBase64" alt="Image">
                                        </div>
                                    }
                                    <div class="name">@item.Name</div>
                                </div>
                                <div class="card-body">
                                    <h3 class="sold">@item.TotalSold</h3>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const chartOptions = {
        chart: {
            type: 'area',
            height: 500,
            animations: {
                enabled: true,
                easing: 'easeinout',
                speed: 800,
                animateGradually: {
                    enabled: true,
                    delay: 150
                },
                dynamicAnimation: {
                    enabled: true,
                    speed: 350
                }
            },
            toolbar: {
                show: false
            },
            background: 'transparent'
        },
        colors: [
            '#342825',  // Original Color
            '#2b1e1b',  // Darker Shade 1
            '#251b1b',  // Darker Shade 2
            '#4a3a38',  // Lighter Shade 1
            '#5f4e4c'   // Lighter Shade 2
        ],
        fill: {
            type: 'gradient',
            gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.7,
                opacityTo: 0.9,
                stops: [20, 90, 100]
            }
        },
        dataLabels: {
            enabled: false
        },
        stroke: {
            curve: 'smooth',
            width: 3
        },
        xaxis: {
            categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            labels: {
                style: {
                    colors: '#000'
                }
            }
        },
        yaxis: {
            labels: {
                style: {
                    colors: '#000'
                }
            }
        },
        tooltip: {
            theme: 'dark'
        },
        grid: {
            borderColor: 'rgba(0, 0, 0, .4)'
        }
    };

    const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(salesData));

    console.log(salesData);

    // Extract months and amounts for the chart
    const chartMonths = salesData.map(data => data.Month);
    const chartAmounts = salesData.map(data => data.Amount);

    const salesChart = new ApexCharts(document.querySelector("#salesChart"), {
        ...chartOptions,
        series: [{
            name: 'Sales',
            data: chartAmounts
        }],
        xaxis: {
            categories: chartMonths // Set the x-axis to display the months
        }
    });
    salesChart.render();
</script>