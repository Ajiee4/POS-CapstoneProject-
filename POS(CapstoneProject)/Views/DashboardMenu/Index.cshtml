@using Newtonsoft.Json;
@using System.Text.Json
@using Newtonsoft.Json.Linq;
@using POS_CapstoneProject_.DTO;

@{
    Layout = "/Views/Shared/_ManagerLayout.cshtml";
    var salesReportJson = ViewData["SalesData"] as string;
    var salesData = string.IsNullOrEmpty(salesReportJson) ? null : JsonConvert.DeserializeObject<List<SalesData>>(salesReportJson);

  
    var monthlyRanking = ViewData["monthlyRanking"] as string;
    var yearlyRanking = ViewData["yearlyRanking"] as string;
    var dailyRanking = ViewData["dailyRanking"] as string;

    var dailyRankingList = string.IsNullOrEmpty(dailyRanking) ? null : JsonConvert.DeserializeObject<List<SalesReport>>(dailyRanking);
    var monthlyRankingList = string.IsNullOrEmpty(monthlyRanking) ? null : JsonConvert.DeserializeObject<List<SalesReport>>(monthlyRanking);
    var yearlyRankingList = string.IsNullOrEmpty(yearlyRanking) ? null : JsonConvert.DeserializeObject<List<SalesReport>>(yearlyRanking);
}

<style>
    .link-dashboard {
        background-color: #747474 !important;
    }
</style>

<!--Loader-->
<div class="loader-wrapper">
    <div class="loader"></div>
</div>


<div class="dashboard-wrapper">
    <div class="topbox">
      
          <div class="box">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        @ViewData["UCount"]
                    </div>
                    <div class="noUser">
                        Users
                    </div>
                </div>

                <div class="box-top-right">
                    <img src="~/images/totalUsers.png" />
                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">
                    <a href="@Url.Action("Index", "UserManagementMenu")">
                        <div class="view-wrapper">
                            <span class="view-more">view more</span>
                            <img src="~/images/next-black.png" />
                        </div>


                    </a>
                </div>
            </div>
        </div>
          <div class="box">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        @ViewData["DailySales"]

                    </div>
                    <div class="noUser">
                        Daily Sales

                    </div>
                </div>

                <div class="box-top-right">
                    <img src="~/images/totalSales.png" />
                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">
                    <a href="@Url.Action("Index", "SalesReportMenu")">
                        <div class="view-wrapper">
                            <span class="view-more">view more</span>
                            <img src="~/images/next-black.png" />
                        </div>


                    </a>
                </div>
            </div>
        </div>
          <div class="box">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        @ViewData["PCount"]

                    </div>
                    <div class="noUser">
                         Products

                    </div>
                </div>

                <div class="box-top-right">
                    <img src="~/images/products_b.png" />
                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">
                    <a href="@Url.Action("Index", "ProductMenu")">
                        <div class="view-wrapper">
                            <span class="view-more">view more</span>
                            <img src="~/images/next-black.png" />
                        </div>


                    </a>
                </div>
            </div>
        </div>
          <div class="box">
            <div class="box-top">
                <div class="box-top-left">
                    <div class="count-text">
                        @ViewData["PendingRequest"]

                    </div>
                    <div class="noUser">
                        Pending Requests 

                    </div>
                </div>

                <div class="box-top-right">
                    <img src="~/images/totalUsers.png" />
                </div>
            </div>

            <div class="box-bottom">
                <div class="box-bottom-view">
                    <a href="@Url.Action("RequestList", "InventoryMenu")">
                        <div class="view-wrapper">
                            <span class="view-more">view more</span>
                            <img src="~/images/next-black.png" />
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="middlebox">
        <div class="charts-container">
            <h3>Sales Analytics</h3>
            <div id="salesChart"></div>
           
        </div>

        <div id="leaderboard"> 
            <div class="leaderboard-header">
                <h3 class="card-title"> Product Ranking</h3>
                <div class="sortbutton">
                    <button class="active" onclick="filterProdRanking('Daily', this)">Daily </button>
                    <button  onclick="filterProdRanking('Monthly', this)">Monthly </button>
                    <button  onclick="filterProdRanking('Yearly', this)">Yearly </button>
                </div>
            </div>
           
            <div class="ranking">              
               <div class="daily-ranking">
                    @if (ViewData["dailyRanking"] != null)
                    {
                        if(dailyRankingList.Count == 0)
                        {
                            <div class="noDataRanking">No data</div>
                        }
                        else
                        {
                            int rank = 1;
                            foreach (var item in dailyRankingList)
                            {
                                <div class="card">
                                    <div class="card-header">
                                        @if (rank == 1)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crowngold.png" class="crown-gold-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else if (rank == 2)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crownsilver.png" class="crown-silver-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else if (rank == 3)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crownbronze.png" class="crown-bronze-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else
                                        {
                                            <div class="low-rank">
                                                <span class="rank">@rank</span>
                                                <div class="name">@item.Name</div>
                                            </div>

                                        }
                                    </div>
                                    <div class="card-body">
                                        <span class="sold">@item.TotalSold</span>
                                    </div>
                                </div>
                                rank++;
                            }
                        }
                      
                    }
                   
                </div>

                <div class="monthly-ranking">
                    @if (ViewData["monthlyRanking"] != null)
                    {
                        if(monthlyRankingList.Count == 0)
                        {
                            <div class="noDataRanking">No data</div>
                        }
                        else
                        {
                            int rank = 1;
                            foreach (var item in monthlyRankingList)
                            {
                                <div class="card">
                                    <div class="card-header">
                                        @if (rank == 1)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crowngold.png" class="crown-gold-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else if (rank == 2)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crownsilver.png" class="crown-silver-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else if (rank == 3)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crownbronze.png" class="crown-bronze-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else
                                        {
                                            <div class="low-rank">
                                                <span class="rank">@rank</span>
                                                <div class="name">@item.Name</div>
                                            </div>

                                        }




                                    </div>
                                    <div class="card-body">
                                        <span class="sold">@item.TotalSold</span>
                                    </div>
                                </div>
                                rank++;
                            }
                        }
                        
                    }
                </div>

                <div class="yearly-ranking">
                    @if (ViewData["yearlyRanking"] != null)
                    {

                        if(yearlyRankingList.Count == 0)
                        {
                            <div class="noDataRanking">No data</div>
                        }
                        else
                        {
                            int rank = 1;
                            foreach (var item in yearlyRankingList)
                            {
                                <div class="card">
                                    <div class="card-header">
                                        @if (rank == 1)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crowngold.png" class="crown-gold-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else if (rank == 2)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crownsilver.png" class="crown-silver-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else if (rank == 3)
                                        {
                                            <div class="top-rank">
                                                <img src="~/images/crownbronze.png" class="crown-bronze-img" />
                                                <span>@rank</span>
                                            </div>

                                            <div class="name">@item.Name</div>
                                        }
                                        else
                                        {
                                            <div class="low-rank">
                                                <span class="rank">@rank</span>
                                                <div class="name">@item.Name</div>
                                            </div>

                                        }
                                    </div>
                                    <div class="card-body">
                                        <span class="sold">@item.TotalSold</span>
                                    </div>
                                </div>
                                rank++;
                            }
                        }
                      
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const chartOptions = {
        chart: {
            type: 'area',
            height: 500,
            animations: {
                enabled: true,
                easing: 'easeinout',
                speed: 800,
                animateGradually: {
                    enabled: true,
                    delay: 150
                },
                dynamicAnimation: {
                    enabled: true,
                    speed: 350
                }
            },
            toolbar: {
                show: false
            },
            background: 'transparent'
        },
        colors: [
            '#342825',  // Original Color
            '#2b1e1b',  // Darker Shade 1
            '#251b1b',  // Darker Shade 2
            '#4a3a38',  // Lighter Shade 1
            '#5f4e4c'   // Lighter Shade 2
        ],
        fill: {
            type: 'gradient',
            gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.7,
                opacityTo: 0.9,
                stops: [20, 90, 100]
            }
        },
        dataLabels: {
            enabled: false
        },
        stroke: {
            curve: 'smooth',
            width: 3
        },
        xaxis: {
            categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            labels: {
                style: {
                    colors: '#000'
                }
            }
        },
        yaxis: {
            labels: {
                style: {
                    colors: '#000'
                }
            }
        },
        tooltip: {
            theme: 'dark'
        },
        grid: {
            borderColor: 'rgba(0, 0, 0, .4)'
        }
    };

    const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(salesData));

    console.log(salesData);

    // Extract months and amounts for the chart
    const chartMonths = salesData.map(data => data.Month);
    const chartAmounts = salesData.map(data => data.Amount);

    const salesChart = new ApexCharts(document.querySelector("#salesChart"), {
        ...chartOptions,
        series: [{
            name: 'Sales',
            data: chartAmounts
        }],
        xaxis: {
            categories: chartMonths // Set the x-axis to display the months
        }
    });
    salesChart.render();
</script>