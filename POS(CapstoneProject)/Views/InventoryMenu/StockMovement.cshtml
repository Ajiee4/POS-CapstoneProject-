@inject POS_CapstoneProject_.Data.POS_CapstoneProject_Context data
@using Newtonsoft.Json;
@{
    Layout = "/Views/Shared/_ManagerLayout.cshtml";
}

<style>
    .link-stockmovement, .inventoryMenu {
        background-color: #747474 !important;
    }
</style>

<!--Loader-->
<div class="loader-wrapper">
    <div class="loader"></div>
</div>

<!--Transaction Type Filter Wrapper-->
<div class="stock-movement-filter-wrapper">
    <form asp-action="StockMovement" method="post" id="stockMovementForm">
        <div class="stock-movement-type-wrapper">
            <label>Type</label>

            <select class="selectTransactionType" name="transactionType">
                <option selected disabled>Select a type</option>
                <option value="All">All</option>
                <option value="Stock In">Stock In</option>
                <option value="Stock Out">Stock Out</option>
            </select>
        </div>

        <div class="stock-movement-fromdate-wrapper">
            <label>From</label>
            <input type="date" class="fromDateStockMove" name="fromDate" />
        </div>

        <div class="stock-movement-todate-wrapper">
            <label>To</label>
            <input type="date" class="toDateStockMove" name="toDate" />
        </div>

        <div class="stock-movement-button-wrapper">
            <button type="button" class="generateRecordBtn">View</button>
        </div>      
    </form>
</div>

<!--Stock Movement Wrapper-->
<div class="stock-movement-wrapper">
    <!--Stock Movement Table-->
    <table class="stock-movement-table general-table">
        <thead>
            <tr>
                <th>Transaction ID</th>
                <th>Requested By</th>
                <th>Date</th>
                <th>Remarks</th>
                <th>Action</th>
                
            </tr>
        </thead>

        <tbody id="stock-movement-body">        
            <!--Inventory Stock In & Stock Out-->
            @if (ViewData["inventoryAll"] != null)
            {
                var inventoryAllList = ViewData["inventoryAll"] as string;
                var inventoryAll = JsonConvert.DeserializeObject<List<InventoryTransaction>>(inventoryAllList);
         
                if(inventoryAll != null)
                {
                    @foreach (var item in inventoryAll)
                    {
                        var checkUser = data.UserDetail.Where(s => s.UserId == item.UserId).FirstOrDefault(); 
                        <tr>
                            <td>@item.InventoryTransactId</td>
                            <td>@checkUser.Firstname @checkUser.Lastname</td>
                            <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Remarks</td>
                            <td><button class="btn viewDetailsBtn" data-transactid="@item.InventoryTransactId" data-toggle="modal" data-target="#viewStockMovementDetails" onclick="viewTransaction(this)">View</button></td>                
                        </tr>
                    }
                }                   
            }
           <!--Inventory Stock in-->
            @if (ViewData["inventoryStockIn"] != null)
            {
                var inventoryStockInList = ViewData["inventoryStockIn"] as string;
                var inventoryStockIn = JsonConvert.DeserializeObject<List<InventoryTransaction>>(inventoryStockInList);       

                if (inventoryStockIn != null)
                {
                    @foreach (var item in inventoryStockIn.Where(s => s.TransactionType == "Stock In"))
                    {
                        var checkUser = data.UserDetail.Where(s => s.UserId == item.UserId).FirstOrDefault();
                        <tr>
                            <td>@item.InventoryTransactId</td>
                            <td>@checkUser.Firstname @checkUser.Lastname</td>
                            <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Remarks</td>
                            <td><button class="btn viewDetailsBtn" data-transactid="@item.InventoryTransactId" data-toggle="modal" data-target="#viewStockMovementDetails" onclick="viewTransaction(this)" >View</button></td>
                        </tr>
                    }
                }              
            }
            <!--Inventory Stock Out-->
            @if (ViewData["inventoryStockOut"] != null)
            {
                var inventoryAllList = ViewData["inventoryStockOut"] as string;
                var inventoryStockOut = JsonConvert.DeserializeObject<List<InventoryTransaction>>(inventoryAllList);
               
                if (inventoryStockOut != null)
                {
                    @foreach (var item in inventoryStockOut.Where(s => s.TransactionType == "Stock Out"))
                    {
                        var checkUser = data.UserDetail.Where(s => s.UserId == item.UserId).FirstOrDefault();
                        <tr>
                            <td>@item.InventoryTransactId</td>
                            <td>@checkUser.Firstname @checkUser.Lastname</td>
                            <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Remarks</td>
                            <td><button class="btn viewDetailsBtn" data-transactid="@item.InventoryTransactId" data-toggle="modal" data-target="#viewStockMovementDetails" onclick="viewTransaction(this)">View</button></td>
                        </tr>
                    }
                }           
            } 
        </tbody>
    </table>
</div>


<!--View Stock Movement Transaction Modal-->
<div class="modal fade general-modal" id="viewStockMovementDetails" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
        @*     <img src="~/images/coffe-logo-light.png" class="add-category-modal-img general-coffee-img-bottom" /> *@

            <div class="modal-header">
                <h5 class="modal-title"> TRANSACTION 
                    DETAILS</h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <br />

            <div class="modal-body">
              <table class="transaction-details-table">
                  <thead>
                      <tr>
                          <th>Ingredient</th>
                          <th>Quantity Movement</th>
                          <th>Quantity On Hand</th>
                          <th>Updated Quantity</th>
                      </tr>
                  </thead>
                  <tbody>
                    
                  </tbody>
              </table>
              <br />
                <button type="button" data-dismiss="modal" class="d-block mx-auto general-modal-button">BACK</button>
            </div>
        </div>
    </div>
</div>




<script>
    let inventoryDetails = @Html.Raw(ViewData["stockMovementDetails"]);
</script>



<!--Set Filter-->
@if (ViewData["inventoryAll"] != null)
{
    <script>
        window.addEventListener('load', function () {
            document.querySelector('.fromDateStockMove').value = localStorage.getItem('fromDateStockMove');
            document.querySelector('.toDateStockMove').value = localStorage.getItem('toDateStockMove');
            document.querySelector('.stock-movement-wrapper').style.visibility = "visible";
            document.querySelector('.selectTransactionType').value = "All"
        });     
    </script>
}
@if (ViewData["inventoryStockOut"] != null)
{
    <script>
        window.addEventListener('load', function () {
            document.querySelector('.fromDateStockMove').value = localStorage.getItem('fromDateStockMove');
            document.querySelector('.toDateStockMove').value = localStorage.getItem('toDateStockMove');
            document.querySelector('.stock-movement-wrapper').style.visibility = "visible";
            document.querySelector('.selectTransactionType').value = "Stock Out"
        });     
    </script>
}
@if (ViewData["inventoryStockIn"] != null)
{
     <script>
        window.addEventListener('load', function () {
            document.querySelector('.fromDateStockMove').value = localStorage.getItem('fromDateStockMove');
            document.querySelector('.toDateStockMove').value = localStorage.getItem('toDateStockMove');
            document.querySelector('.stock-movement-wrapper').style.visibility = "visible";
            document.querySelector('.selectTransactionType').value = "Stock In"
        });     
    </script>
}
